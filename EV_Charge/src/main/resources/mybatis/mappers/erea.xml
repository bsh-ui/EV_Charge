<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.boot.dao.EreaDAO">

    <!-- 지역(도) 선택 -->
    <select id="select_erea_province" resultType="com.boot.dto.EreaDTO">
    	select distinct erea_province from erea
    </select>
    
    <!-- 지역(시) 선택 -->
    <select id="select_erea_city" resultType="com.boot.dto.EreaDTO">
    	select distinct erea_city from erea where erea_province = #{user_province}
    </select>
</mapper>